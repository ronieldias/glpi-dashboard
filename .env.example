GLPI_BASE_URL=http://seu-servidor-glpi/glpi
GLPI_APP_TOKEN=seu_app_token_aqui                               # gerado em: Configuração > Geral > API > Adicionar cliente API
GLPI_USER_TOKEN=seu_user_token_aqui                             # gerado em: Perfil do usuário > Configurações remotas > Regenerar token
NEXT_PUBLIC_POLLING_INTERVAL=30000

# Google Cloud Text-to-Speech (voz dos anúncios). Opcional — sem a chave, a voz fica indisponível.
GOOGLE_TTS_API_KEY=sua_api_key_do_google_cloud   # Console Google Cloud > APIs > Credenciais > Criar chave de API
GOOGLE_TTS_VOICE=pt-BR-Chirp3-HD-Aoede            # voz feminina; alternativas: ...-Kore, ...-Leda, ou pt-BR-Neural2-A
